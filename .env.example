# Token du bot obtenu sur le Discord Developer Portal.
DISCORD_TOKEN=

# URL PostgreSQL fournie par Render.
DATABASE_URL=

# Fuseau utilisé lorsqu'un serveur n'en a pas encore configuré.
DEFAULT_TIMEZONE=Europe/Paris

# development ou production
ENVIRONMENT=development

# Niveau de logs : DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# Facultatif : identifiant de ton serveur de développement.
# Les commandes s'y synchronisent presque immédiatement.
DEV_GUILD_ID=

# Facultatif : ton identifiant Discord.
OWNER_ID=

# Port utilisé par le contrôle de santé Render.
# Render remplit normalement cette valeur automatiquement.
PORT=10000
